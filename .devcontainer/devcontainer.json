{
  "name": "Private Photo Studio",
  "image": "mcr.microsoft.com/devcontainers/miniconda:1.0.0-3",
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": {
      "label": "Private Photo Studio",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "postStartCommand": "bash -lc 'nohup python app.py > /tmp/private-photo-studio.log 2>&1 &'"
}
