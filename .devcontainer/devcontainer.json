{
  "name": "Private Photo Studio",
  "image": "mcr.microsoft.com/devcontainers/miniconda:1.0.0-3",
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": {
      "label": "Private Photo Studio",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "remote.autoForwardPorts": true
      }
    }
  },
  "postCreateCommand": "pip install -r requirements.txt && chmod +x scripts/start_studio.sh",
  "postStartCommand": "bash scripts/start_studio.sh",
  "postAttachCommand": "bash scripts/start_studio.sh"
}
